            "formatString": "#,0",
            "description": "Ad impressions delivered.",
            "displayFolder": "1 Delivery",
            "lineageTag": "d0702776-390d-c852-e128-cf7ce3146722"
          },
          {
            "name": "Total Clicks",
            "expression": "SUM ( fact_campaign_daily[clicks] )",
            "formatString": "#,0",
            "description": "Ad clicks.",
            "displayFolder": "1 Delivery",
            "lineageTag": "4f8b174b-84f8-49f7-13db-76e5ff7cb628"
          },
          {
            "name": "Campaign Video Completions",
            "expression": "SUM ( fact_campaign_daily[video_completions] )",
            "formatString": "#,0",
            "description": "Campaign videos watched to the end.",
            "displayFolder": "1 Delivery",
            "lineageTag": "4a24a7d2-cec3-3bf2-ad5c-09a17ddee252"
          },
          {
            "name": "Total Conversions",
            "expression": "SUM ( fact_campaign_daily[conversions] )",
            "formatString": "#,0",
            "description": "Purchases or installs attributed to the campaign.",
            "displayFolder": "1 Delivery",
            "lineageTag": "a4b770ea-3415-e5d5-2b34-c183c125b086"
          },
          {
            "name": "Spend",
            "expression": "SUM ( fact_campaign_daily[spend_usd] )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Media spend delivered.",
            "displayFolder": "2 Money",
            "lineageTag": "3c7a67b7-f6f7-c2f0-666f-fce1a45f377c"
          },
          {
            "name": "Revenue",
            "expression": "SUM ( fact_campaign_daily[revenue_usd] )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Revenue attributed to the campaign.",
            "displayFolder": "2 Money",
            "lineageTag": "4c5010e9-5bb9-fef6-688d-839648430d14"
          },
          {
            "name": "Profit",
            "expression": "[Revenue] - [Spend]",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Attributed revenue minus media spend.",
            "displayFolder": "2 Money",
            "lineageTag": "7924c4fc-96e8-18f9-d6aa-faa24a6115bb"
          },
          {
            "name": "ROAS",
            "expression": "DIVIDE ( [Revenue], [Spend] )",
            "formatString": "#,0.00",
            "description": "Return on ad spend: revenue per dollar spent.",
            "displayFolder": "2 Money",
            "lineageTag": "d67e00bf-bc15-0719-a802-75c0408c48ee"
          },
          {
            "name": "CTR %",
            "expression": "DIVIDE ( [Total Clicks], [Total Impressions] )",
            "formatString": "0.00%",
            "description": "Campaign click-through rate.",
            "displayFolder": "3 Efficiency",
            "lineageTag": "70b46082-7b8e-9446-73cd-a6976348a7c2"
          },
          {
            "name": "CPM",
            "expression": "DIVIDE ( [Spend] * 1000, [Total Impressions] )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "description": "Cost per 1,000 impressions.",
            "displayFolder": "3 Efficiency",
            "lineageTag": "a7f501cb-c708-c1d9-c46e-591cfb121f3d"
          },
          {
            "name": "CPC",
            "expression": "DIVIDE ( [Spend], [Total Clicks] )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "description": "Cost per click.",
            "displayFolder": "3 Efficiency",
            "lineageTag": "bd84cfaa-2226-ec97-57ba-845da8833290"
          },
          {
            "name": "CPA",
            "expression": "DIVIDE ( [Spend], [Total Conversions] )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "description": "Cost per acquisition.",
            "displayFolder": "3 Efficiency",
            "lineageTag": "56890c67-4ac9-770f-c606-b87283842a62"
          },
          {
            "name": "Conversion Rate %",
            "expression": "DIVIDE ( [Total Conversions], [Total Clicks] )",
            "formatString": "0.0%",
            "description": "Share of clicks that convert.",
            "displayFolder": "3 Efficiency",
            "lineageTag": "4c81602e-b5bf-58b0-8edd-341086f607e5"
          },
          {
            "name": "Campaign Video Completion Rate %",
            "expression": "DIVIDE ( [Campaign Video Completions], [Total Impressions] )",
            "formatString": "0.0%",
            "description": "Share of impressions watched to the end.",
            "displayFolder": "3 Efficiency",
            "lineageTag": "9b07b408-27c2-64eb-651f-ac865873376d"
          },
          {
            "name": "Budget",
            "expression": "SUM ( dim_campaigns[total_budget_usd] )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Budget committed by the advertiser.",
            "displayFolder": "2 Money",
            "lineageTag": "c19af5fa-c5e1-6668-37f6-ec373ac319c9"
          },
          {
            "name": "Budget Used %",
            "expression": "DIVIDE ( [Spend], [Budget] )",
            "formatString": "0.0%",
            "description": "Share of committed budget actually delivered.",
            "displayFolder": "2 Money",
            "lineageTag": "fd7e45ce-73af-e837-03a5-336eb2dfbbce"
          },
          {
            "name": "Spend Running Total",
            "expression": "CALCULATE ( [Spend], FILTER ( ALLSELECTED ( dim_date[date] ), dim_date[date] <= MAX ( dim_date[date] ) ) )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Cumulative spend across the selected period.",
            "displayFolder": "2 Money",
            "lineageTag": "c160e0b2-88b0-0be0-6d95-e94c38492ba7"
          },
          {
            "name": "Conversions Running Total",
            "expression": "CALCULATE ( [Total Conversions], FILTER ( ALLSELECTED ( dim_date[date] ), dim_date[date] <= MAX ( dim_date[date] ) ) )",
            "formatString": "#,0",
            "description": "Cumulative conversions across the selected period.",
            "displayFolder": "1 Delivery",
            "lineageTag": "25955eea-9f20-e4f8-cce6-d72a707c4d49"
          }
        ],
        "lineageTag": "09b5c021-7260-1fe0-31bc-48794bdbe1cb"
      },
