          }
        ],
        "measures": [
          {
            "name": "Avg Impulse Buying Score",
            "expression": "AVERAGE ( dim_psychographics[impulse_buying_score] )",
            "formatString": "#,0.0",
            "description": "Modeled tendency to buy on impulse.",
            "lineageTag": "0036927f-146a-d795-f911-3b4c19fd9d1e"
          },
          {
            "name": "Avg Social Influence Score",
            "expression": "AVERAGE ( dim_psychographics[social_influence_score] )",
            "formatString": "#,0.0",
            "description": "Modeled sway over the student's own network.",
            "lineageTag": "dfa1d2ac-7560-407b-e51e-ca8ddab60f90"
          },
          {
            "name": "Avg Attention Span Score",
            "expression": "AVERAGE ( dim_psychographics[attention_span_score] )",
            "formatString": "#,0.0",
            "description": "Modeled attention span.",
            "lineageTag": "f7e64b99-8a8f-089c-21bd-51cdcd614aaf"
          },
          {
            "name": "Avg Openness",
            "expression": "AVERAGE ( dim_psychographics[openness] )",
            "formatString": "#,0.0",
            "description": "Big Five openness.",
            "displayFolder": "Big Five",
            "lineageTag": "3093317c-5a79-3c94-d55b-a476be3971b2"
          },
          {
            "name": "Avg Conscientiousness",
            "expression": "AVERAGE ( dim_psychographics[conscientiousness] )",
            "formatString": "#,0.0",
            "description": "Big Five conscientiousness.",
            "displayFolder": "Big Five",
            "lineageTag": "400b0071-8f82-1f1a-3703-d649b877933c"
          },
          {
            "name": "Avg Extraversion",
            "expression": "AVERAGE ( dim_psychographics[extraversion] )",
            "formatString": "#,0.0",
            "description": "Big Five extraversion.",
            "displayFolder": "Big Five",
            "lineageTag": "800a265a-35fc-f421-24f2-bab592f95eb9"
          },
          {
            "name": "Avg Agreeableness",
            "expression": "AVERAGE ( dim_psychographics[agreeableness] )",
            "formatString": "#,0.0",
            "description": "Big Five agreeableness.",
            "displayFolder": "Big Five",
            "lineageTag": "184bd826-95ee-da29-8dd3-f6447887ee8d"
          },
          {
            "name": "Avg Neuroticism",
            "expression": "AVERAGE ( dim_psychographics[neuroticism] )",
            "formatString": "#,0.0",
            "description": "Big Five neuroticism.",
            "displayFolder": "Big Five",
            "lineageTag": "b6740f4b-6954-0c68-f671-18c9fec11d30"
          },
          {
            "name": "% Political Lean Inferred",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( dim_psychographics ), dim_psychographics[inferred_political_lean] <> \"Not inferred\" ), COUNTROWS ( dim_psychographics ) )",
            "formatString": "0.0%",
            "description": "Share of students given a political label they never volunteered.",
            "lineageTag": "7a7cb07b-747e-c7c7-e2a8-dad661d96e80"
          },
          {
            "name": "Avg Political Lean Confidence",
            "expression": "CALCULATE ( AVERAGE ( dim_psychographics[political_lean_confidence] ), dim_psychographics[inferred_political_lean] <> \"Not inferred\" )",
            "formatString": "0.00",
            "description": "Model confidence where a political label was assigned.",
            "lineageTag": "833458ac-cd62-55b5-2e0d-7d75bcbc5a5d"
          },
          {
            "name": "In-Market Students",
            "expression": "CALCULATE ( COUNTROWS ( dim_psychographics ), FILTER ( dim_psychographics, dim_psychographics[intent_new_phone] = TRUE || dim_psychographics[intent_travel_6mo] = TRUE || dim_psychographics[intent_meal_delivery] = TRUE || dim_psychographics[intent_gym_membership] = TRUE || dim_psychographics[intent_credit_card] = TRUE ) )",
            "formatString": "#,0",
            "description": "Students flagged as in-market for at least one product category.",
            "lineageTag": "fd943c8c-a5ce-30b8-4367-7bd0b0c52ae8"
          }
        ],
        "lineageTag": "44c3afd6-9494-c51a-0344-92a8f4f1fc27"
      },
