          {
            "name": "% Ad Tracking Allowed",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( dim_devices ), dim_devices[ad_tracking_allowed] = TRUE ), CALCULATE ( COUNTROWS ( dim_devices ), dim_devices[device_type] = \"Smartphone\" ) )",
            "formatString": "0.0%",
            "description": "Phones allowing cross-app tracking (iOS asks, Android defaults on).",
            "lineageTag": "7878b4d2-08e9-59c7-82e9-70ff2993b958"
          },
