        "measures": [
          {
            "name": "Segment Members",
            "expression": "DISTINCTCOUNT ( bridge_user_segments[user_id] )",
            "formatString": "#,0",
            "description": "Students in the selected segment(s).",
            "lineageTag": "0a2bb1fb-7ce2-4df2-48df-43aa4c53cfa2"
          },
          {
            "name": "Avg Match Strength",
            "expression": "AVERAGE ( bridge_user_segments[match_strength] )",
            "formatString": "#,0.0",
            "description": "How strongly members fit the segment.",
            "lineageTag": "f6ec5717-38c4-50fb-c7d0-1abac5bbfb58"
          },
          {
            "name": "Segments per Student",
            "expression": "DIVIDE ( COUNTROWS ( bridge_user_segments ), DISTINCTCOUNT ( bridge_user_segments[user_id] ) )",
