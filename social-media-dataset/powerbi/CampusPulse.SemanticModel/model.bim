        ],
        "partitions": [
          {
            "name": "bridge_user_interests",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(DataFile(\"bridge_user_interests.csv\"), [Delimiter=\",\", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"user_id\", type text}, {\"interest_id\", type text}, {\"affinity_score\", Int64.Type}, {\"source\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Students with Interest",
            "expression": "DISTINCTCOUNT ( bridge_user_interests[user_id] )",
            "formatString": "#,0",
            "description": "Students carrying the selected interest tag(s).",
            "lineageTag": "feb2a801-c023-26ec-7fba-fe0a3b3bcb48"
          },
          {
            "name": "Avg Affinity",
            "expression": "AVERAGE ( bridge_user_interests[affinity_score] )",
            "formatString": "#,0.0",
            "description": "Average strength of the interest signal.",
            "lineageTag": "f102de24-779f-fd3a-7f7e-78a713b27535"
          },
          {
            "name": "Interest Tags",
            "expression": "COUNTROWS ( bridge_user_interests )",
            "formatString": "#,0",
            "description": "Interest tags applied.",
            "lineageTag": "93708598-de47-b6b2-1633-53fc0d807c12"
          },
          {
            "name": "Tags per Student",
            "expression": "DIVIDE ( COUNTROWS ( bridge_user_interests ), DISTINCTCOUNT ( bridge_user_interests[user_id] ) )",
            "formatString": "#,0.0",
            "description": "Interest tags held per student.",
            "lineageTag": "a24036aa-3071-b119-b365-14366dd23403"
          },
          {
            "name": "% Inferred Not Declared",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( bridge_user_interests ), bridge_user_interests[source] <> \"Declared\" ), COUNTROWS ( bridge_user_interests ) )",
            "formatString": "0.0%",
            "description": "Share of interest tags the student never actually told anyone.",
            "lineageTag": "ada49816-3102-9ff8-50b0-37fcc348ae83"
          }
        ],
        "lineageTag": "c5018973-46dc-6238-bfcc-e727be19f74d"
