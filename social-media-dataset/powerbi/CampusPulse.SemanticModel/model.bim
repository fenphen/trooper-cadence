                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"user_id\", type text}, {\"campaign_id\", type text}, {\"platform\", type text}, {\"impressions\", Int64.Type}, {\"clicks\", Int64.Type}, {\"video_completions\", Int64.Type}, {\"conversions\", Int64.Type}, {\"first_exposure_date\", type date}, {\"last_exposure_date\", type date}}, \"en-US\")",
