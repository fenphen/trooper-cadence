        "measures": [
          {
            "name": "Panel Reach",
            "expression": "DISTINCTCOUNT ( fact_ad_exposures[user_id] )",
            "formatString": "#,0",
            "description": "Panel members who saw the campaign at least once.",
            "lineageTag": "b969136c-efbd-3364-c011-7480c9948417"
          },
          {
            "name": "Panel Impressions",
            "expression": "SUM ( fact_ad_exposures[impressions] )",
            "formatString": "#,0",
            "description": "Impressions measured on the research panel.",
            "lineageTag": "45b7db83-b928-a797-f8bc-fa77ac2a5fd9"
          },
          {
            "name": "Avg Frequency",
            "expression": "DIVIDE ( [Panel Impressions], [Panel Reach] )",
            "formatString": "#,0.0",
            "description": "Average times one person saw the campaign.",
            "lineageTag": "5f3f0369-b7bd-4863-3e04-9fdfe26b9d7a"
          },
          {
            "name": "Panel Converters",
            "expression": "CALCULATE ( DISTINCTCOUNT ( fact_ad_exposures[user_id] ), fact_ad_exposures[conversions] > 0 )",
            "formatString": "#,0",
            "description": "Panel members who converted.",
            "lineageTag": "0ffcfd53-8e46-938e-e231-093409b9849b"
          },
          {
            "name": "Panel Conversion Rate %",
            "expression": "DIVIDE ( [Panel Converters], [Panel Reach] )",
            "formatString": "0.0%",
            "description": "Share of reached panel members who converted.",
            "lineageTag": "d55f6eba-798e-e9b8-c098-155edbd77eb5"
          },
          {
            "name": "Reach %",
            "expression": "DIVIDE ( [Panel Reach], [Panel Size] )",
            "formatString": "0.0%",
            "description": "Share of the whole panel this campaign reached.",
            "lineageTag": "5cf12671-21ca-7201-28cb-edcc4249e17e"
          }
        ],
        "lineageTag": "ff623bd1-a9fe-f677-429d-0d8801d1334d"
