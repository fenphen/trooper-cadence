        "partitions": [
          {
            "name": "dim_users",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(DataFile(\"dim_users.csv\"), [Delimiter=\",\", Columns=24, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"user_id\", type text}, {\"first_name\", type text}, {\"last_name\", type text}, {\"gender\", type text}, {\"age\", Int64.Type}, {\"birth_date\", type date}, {\"email\", type text}, {\"phone\", type text}, {\"hashed_email\", type text}, {\"university\", type text}, {\"campus_city\", type text}, {\"campus_state\", type text}, {\"campus_lat\", type number}, {\"campus_lon\", type number}, {\"housing_type\", type text}, {\"class_year\", type text}, {\"major\", type text}, {\"hometown_city\", type text}, {\"hometown_state\", type text}, {\"hometown_lat\", type number}, {\"hometown_lon\", type number}, {\"relationship_status\", type text}, {\"has_part_time_job\", type logical}, {\"est_monthly_discretionary_spend_usd\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Panel Size",
            "expression": "DISTINCTCOUNT ( dim_users[user_id] )",
            "formatString": "#,0",
            "description": "Students in the research panel.",
            "lineageTag": "f8b46971-ffdd-7e8f-1eff-a0b92eab3dc9"
          },
          {
            "name": "Avg Age",
            "expression": "AVERAGE ( dim_users[age] )",
            "formatString": "#,0.0",
            "description": "Average age.",
            "lineageTag": "df9c3877-8507-1223-b2b9-734acc22bca8"
          },
          {
            "name": "Avg Discretionary Spend",
            "expression": "AVERAGE ( dim_users[est_monthly_discretionary_spend_usd] )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Modeled monthly spending power.",
            "lineageTag": "5488412e-8900-a6b8-12ff-2de11d4f6ecc"
          },
          {
            "name": "Total Discretionary Spend",
            "expression": "SUM ( dim_users[est_monthly_discretionary_spend_usd] )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Combined monthly spending power of the selection.",
            "lineageTag": "bbeb9a90-f9ae-9e3a-4919-31d1106a4a5a"
          },
          {
            "name": "% With Part-Time Job",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( dim_users ), dim_users[has_part_time_job] = TRUE ), COUNTROWS ( dim_users ) )",
            "formatString": "0.0%",
            "description": "Share holding a part-time job.",
            "lineageTag": "f9b72c1e-6738-b920-fafd-6263f166c757"
          },
          {
            "name": "Universities",
            "expression": "DISTINCTCOUNT ( dim_users[university] )",
            "formatString": "#,0",
            "description": "Campuses represented.",
            "lineageTag": "15f1324d-709a-43c1-8f8c-b3913e175aa9"
          }
        ],
        "lineageTag": "13dd412c-acb7-43f7-9509-bb5b9485a6d0"
