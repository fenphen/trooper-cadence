        "partitions": [
          {
            "name": "fact_hourly_usage",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(DataFile(\"fact_hourly_usage.csv\"), [Delimiter=\",\", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"user_id\", type text}, {\"day_type\", type text}, {\"hour_of_day\", Int64.Type}, {\"avg_minutes\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Avg Minutes in Hour",
            "expression": "SUM ( fact_hourly_usage[avg_minutes] )",
            "formatString": "#,0.0",
            "description": "Typical minutes online in the selected hour(s).",
            "lineageTag": "47ccd8f2-be2f-1fca-5c14-5661f8415670"
          },
          {
            "name": "Avg Minutes per Student in Hour",
            "expression": "DIVIDE ( SUM ( fact_hourly_usage[avg_minutes] ), DISTINCTCOUNT ( fact_hourly_usage[user_id] ) )",
            "formatString": "#,0.00",
            "description": "Per-student minutes in the selected hour(s).",
            "lineageTag": "8600ad8f-5e63-5819-85d4-cdbbb56a85c6"
          }
        ],
        "lineageTag": "7bd7776f-4e78-99fe-77fe-ddcce2bd78b9"
