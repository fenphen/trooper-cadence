            "name": "Segments",
            "expression": "COUNTROWS ( dim_segments )",
            "formatString": "#,0",
            "description": "Packaged audiences.",
            "lineageTag": "f533f746-2961-840b-838f-30672fa7ca41"
          },
          {
            "name": "Avg Suggested CPM",
            "expression": "AVERAGE ( dim_segments[suggested_cpm_usd] )",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "description": "Average rate card price per 1,000 impressions.",
            "lineageTag": "a594bb38-43e7-31c6-2410-e6891dca96b7"
          },
          {
            "name": "Segment List Value",
            "expression": "SUMX ( dim_segments, dim_segments[member_count] * dim_segments[suggested_cpm_usd] )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Rate-card value of the audience: members x CPM.",
            "lineageTag": "1c9cc58c-87d6-c2ba-607e-8d834b5bfc83"
          }
