        "measures": [
          {
            "name": "Columns Tracked",
            "expression": "COUNTROWS ( data_dictionary )",
            "formatString": "#,0",
            "description": "Data points held on every student.",
            "lineageTag": "de78c0b0-123a-9230-23b2-6749c701c7af"
          },
          {
            "name": "Declared Columns",
            "expression": "CALCULATE ( COUNTROWS ( data_dictionary ), data_dictionary[collection_method] = \"Declared by user\" )",
            "formatString": "#,0",
            "description": "Columns the user actually typed in themselves.",
            "lineageTag": "d1b3cbe9-9025-6c3e-0dde-aee8dcc857cc"
          },
          {
            "name": "Inferred Columns",
            "expression": "CALCULATE ( COUNTROWS ( data_dictionary ), data_dictionary[collection_method] = \"Inferred by model\" )",
            "formatString": "#,0",
            "description": "Columns produced by a model, never volunteered.",
            "lineageTag": "afc3a475-4d85-35fa-c978-056ecb628146"
          },
          {
            "name": "Observed Columns",
            "expression": "CALCULATE ( COUNTROWS ( data_dictionary ), data_dictionary[collection_method] = \"Observed behavior\" )",
            "formatString": "#,0",
            "description": "Columns recorded by watching behavior.",
            "lineageTag": "a194294f-3788-4571-0ac2-f5a0a0db06df"
          },
          {
            "name": "% Declared",
            "expression": "DIVIDE ( [Declared Columns], [Columns Tracked] )",
            "formatString": "0.0%",
            "description": "Share of everything held that the student knowingly provided.",
            "lineageTag": "a9c79d5e-b037-1b2f-c78a-9dfec2de8903"
          },
          {
            "name": "% Inferred",
            "expression": "DIVIDE ( [Inferred Columns], [Columns Tracked] )",
            "formatString": "0.0%",
            "description": "Share of everything held that was guessed by a model.",
            "lineageTag": "0711d921-bd76-7f65-42c4-6b9c7a3d1608"
          },
          {
            "name": "High Sensitivity Columns",
            "expression": "CALCULATE ( COUNTROWS ( data_dictionary ), data_dictionary[sensitivity] = \"High\" )",
            "formatString": "#,0",
            "description": "Columns tagged high sensitivity.",
            "lineageTag": "65e7b509-950e-e329-d3fa-85d3051529e7"
          },
          {
            "name": "% High Sensitivity",
            "expression": "DIVIDE ( [High Sensitivity Columns], [Columns Tracked] )",
            "formatString": "0.0%",
            "description": "Share of columns tagged high sensitivity.",
            "lineageTag": "4c6bee42-6d83-f11e-45d5-be730d05af88"
          }
        ],
        "lineageTag": "8d7affdc-4a32-6501-df8b-780a642ef4b0"
