        "measures": [
          {
            "name": "Accounts",
            "expression": "COUNTROWS ( dim_platform_profiles )",
            "formatString": "#,0",
            "description": "Social accounts held.",
            "displayFolder": "1 Reach",
            "lineageTag": "90707bab-c5a9-2d00-7c61-f74e2e61a385"
          },
          {
            "name": "Platforms per Student",
            "expression": "DIVIDE ( COUNTROWS ( dim_platform_profiles ), DISTINCTCOUNT ( dim_platform_profiles[user_id] ) )",
            "formatString": "#,0.00",
            "description": "Average number of platforms each student is on.",
            "displayFolder": "1 Reach",
            "lineageTag": "6d536fd7-5f4e-3345-c3d0-807f2eaf8a87"
          },
          {
            "name": "Adoption %",
            "expression": "DIVIDE ( DISTINCTCOUNT ( dim_platform_profiles[user_id] ), [Panel Size] )",
            "formatString": "0.0%",
            "description": "Share of the panel with an account here.",
            "displayFolder": "1 Reach",
            "lineageTag": "7f7b32e1-2e78-bc50-161f-1de1a7bc5de2"
          },
          {
            "name": "Total Followers",
            "expression": "SUM ( dim_platform_profiles[follower_count] )",
            "formatString": "#,0",
            "description": "Combined follower count.",
            "displayFolder": "1 Reach",
            "lineageTag": "ed5f0029-55fe-56a3-1ff2-b062dcfde1b7"
          },
          {
            "name": "Avg Followers",
            "expression": "AVERAGE ( dim_platform_profiles[follower_count] )",
            "formatString": "#,0",
            "description": "Average followers per account.",
            "displayFolder": "1 Reach",
            "lineageTag": "6bf3bd38-6d0d-fe8d-8ca6-740c3ae07fef"
          },
          {
            "name": "Median Followers",
            "expression": "MEDIAN ( dim_platform_profiles[follower_count] )",
            "formatString": "#,0",
            "description": "Median followers - far below the average, because a few accounts are huge.",
            "displayFolder": "1 Reach",
            "lineageTag": "11b28e6b-b010-53f0-5091-d53f0bf1d1de"
          },
          {
            "name": "Avg Posts per Week",
            "expression": "AVERAGE ( dim_platform_profiles[posts_per_week] )",
            "formatString": "#,0.0",
            "description": "Average posting frequency.",
            "displayFolder": "1 Reach",
            "lineageTag": "2b985308-3ad0-cf8e-88fa-534f1179806a"
          },
          {
            "name": "Avg Engagement Rate %",
            "expression": "DIVIDE ( AVERAGE ( dim_platform_profiles[engagement_rate_pct] ), 100 )",
            "formatString": "0.00%",
            "description": "Engagements per follower per post - it falls as follower count rises.",
            "displayFolder": "1 Reach",
            "lineageTag": "d5fcc886-ecda-c396-b964-75c2ef625c03"
          },
          {
            "name": "% Ads Personalization On",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( dim_platform_profiles ), dim_platform_profiles[ad_personalization_enabled] = TRUE ), COUNTROWS ( dim_platform_profiles ) )",
            "formatString": "0.0%",
            "description": "Accounts that left personalized advertising switched on.",
            "displayFolder": "2 Privacy settings",
            "lineageTag": "731f36fc-a428-0e9f-d70e-70b03339f627"
          },
          {
            "name": "% Location Sharing On",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( dim_platform_profiles ), dim_platform_profiles[location_sharing_enabled] = TRUE ), COUNTROWS ( dim_platform_profiles ) )",
            "formatString": "0.0%",
            "description": "Accounts sharing precise location with the app.",
            "displayFolder": "2 Privacy settings",
            "lineageTag": "0bab6f0c-c58d-0a05-cce9-0a4dc7a85440"
          },
          {
            "name": "% Contacts Uploaded",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( dim_platform_profiles ), dim_platform_profiles[contacts_synced] = TRUE ), COUNTROWS ( dim_platform_profiles ) )",
            "formatString": "0.0%",
            "description": "Accounts that uploaded their phone contact list.",
            "displayFolder": "2 Privacy settings",
            "lineageTag": "1f2aafe3-63a8-ae63-fa78-689856a9eca9"
          },
          {
            "name": "% Private Accounts",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( dim_platform_profiles ), dim_platform_profiles[is_private_account] = TRUE ), COUNTROWS ( dim_platform_profiles ) )",
            "formatString": "0.0%",
            "description": "Accounts set to private.",
            "displayFolder": "2 Privacy settings",
            "lineageTag": "977f7dde-9642-1440-8fda-42371ce143b2"
          },
          {
            "name": "Micro-Influencers",
