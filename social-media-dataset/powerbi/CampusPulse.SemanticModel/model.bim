        "partitions": [
          {
            "name": "fact_engagement_daily",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(DataFile(\"fact_engagement_daily.csv\"), [Delimiter=\",\", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"activity_date\", type date}, {\"user_id\", type text}, {\"platform\", type text}, {\"active_minutes\", Int64.Type}, {\"sessions\", Int64.Type}, {\"posts_viewed\", Int64.Type}, {\"videos_viewed\", Int64.Type}, {\"avg_video_completion_pct\", type number}, {\"videos_forwarded\", Int64.Type}, {\"likes_given\", Int64.Type}, {\"comments_written\", Int64.Type}, {\"posts_created\", Int64.Type}, {\"stories_viewed\", Int64.Type}, {\"ads_seen\", Int64.Type}, {\"ads_clicked\", Int64.Type}, {\"late_night_minutes\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Total Minutes",
            "expression": "SUM ( fact_engagement_daily[active_minutes] )",
            "formatString": "#,0",
            "description": "Total minutes spent in social apps.",
            "displayFolder": "1 Volume",
            "lineageTag": "90e08c83-0270-97bf-143f-69c931e6a457"
          },
          {
            "name": "Total Hours",
            "expression": "DIVIDE ( [Total Minutes], 60 )",
            "formatString": "#,0",
            "description": "Total minutes expressed in hours.",
            "displayFolder": "1 Volume",
            "lineageTag": "3d522160-552d-0817-dbdf-0501c0dbc36d"
          },
          {
            "name": "Active Students",
            "expression": "DISTINCTCOUNT ( fact_engagement_daily[user_id] )",
            "formatString": "#,0",
            "description": "Distinct students with activity in the selected period.",
            "displayFolder": "1 Volume",
            "lineageTag": "d0ad155c-00c0-e97e-5406-e5b47d3295fa"
          },
          {
            "name": "Active Days",
            "expression": "COUNTROWS ( fact_engagement_daily )",
            "formatString": "#,0",
            "description": "User-platform-days recorded.",
            "displayFolder": "1 Volume",
            "lineageTag": "18a18023-18c6-2e7e-3aca-1e0ae05874f0"
          },
          {
            "name": "Avg Minutes per Student per Day",
            "expression": "DIVIDE ( [Total Minutes], [Active Days] )",
            "formatString": "#,0.0",
            "description": "Average minutes on one platform on one active day.",
            "displayFolder": "2 Rates",
            "lineageTag": "ec6ddcd9-9f95-fd02-703c-b20277109295"
          },
          {
            "name": "Avg Daily Minutes per Student",
            "expression": "DIVIDE ( [Total Minutes], DISTINCTCOUNT ( fact_engagement_daily[activity_date] ) * [Active Students] )",
            "formatString": "#,0.0",
            "description": "Average total minutes per student per calendar day, all platforms.",
            "displayFolder": "2 Rates",
            "lineageTag": "15a138a5-6341-c1f9-46c0-23e2677d5ae5"
          },
          {
            "name": "Total Sessions",
            "expression": "SUM ( fact_engagement_daily[sessions] )",
            "formatString": "#,0",
            "description": "App opens.",
            "displayFolder": "1 Volume",
            "lineageTag": "5862d637-055d-1a32-6eff-e08b627e6892"
          },
          {
            "name": "Avg Session Length",
            "expression": "DIVIDE ( [Total Minutes], [Total Sessions] )",
            "formatString": "#,0.0",
            "description": "Average minutes per app session.",
            "displayFolder": "2 Rates",
            "lineageTag": "c36ca946-9092-eea7-da5f-59785c5a5dfa"
          },
          {
            "name": "Posts Viewed",
            "expression": "SUM ( fact_engagement_daily[posts_viewed] )",
            "formatString": "#,0",
            "description": "Pieces of content served.",
            "displayFolder": "1 Volume",
            "lineageTag": "eb2d6ee6-9a00-8d30-0b72-482527098db6"
          },
          {
            "name": "Videos Viewed",
            "expression": "SUM ( fact_engagement_daily[videos_viewed] )",
            "formatString": "#,0",
            "description": "Videos served.",
            "displayFolder": "3 Video",
            "lineageTag": "173d93e9-dab7-5e0b-47df-8ccde1a44628"
          },
          {
            "name": "Video Completion %",
            "expression": "DIVIDE ( SUMX ( fact_engagement_daily, fact_engagement_daily[videos_viewed] * fact_engagement_daily[avg_video_completion_pct] ), [Videos Viewed] * 100 )",
            "formatString": "0.0%",
            "description": "Average share of each video watched, weighted by videos viewed.",
            "displayFolder": "3 Video",
            "lineageTag": "71497fa3-8bb0-ddb7-551a-ebf74a9b4c30"
          },
          {
            "name": "Videos Forwarded",
            "expression": "SUM ( fact_engagement_daily[videos_forwarded] )",
            "formatString": "#,0",
            "description": "Videos shared or forwarded to someone else.",
            "displayFolder": "3 Video",
            "lineageTag": "620faa3b-422a-af23-5044-c232782eab43"
          },
          {
            "name": "Forward Rate per 1K Videos",
            "expression": "DIVIDE ( [Videos Forwarded], [Videos Viewed] ) * 1000",
            "formatString": "#,0.0",
            "description": "Videos forwarded for every 1,000 videos watched.",
            "displayFolder": "3 Video",
            "lineageTag": "48b2deb8-c4d0-ed5d-472b-bc88189f4dc2"
          },
          {
            "name": "Forward Rate %",
            "expression": "DIVIDE ( [Videos Forwarded], [Videos Viewed] )",
            "formatString": "0.00%",
            "description": "Share of watched videos that get forwarded.",
            "displayFolder": "3 Video",
            "lineageTag": "5cee3e66-b42f-6c8b-2ac8-23699c55e91f"
          },
          {
            "name": "Likes Given",
            "expression": "SUM ( fact_engagement_daily[likes_given] )",
            "formatString": "#,0",
            "description": "Likes and reactions given.",
            "displayFolder": "4 Interaction",
            "lineageTag": "6990fdd4-133a-342c-4caa-4f5d06fe9736"
          },
          {
            "name": "Comments Written",
            "expression": "SUM ( fact_engagement_daily[comments_written] )",
            "formatString": "#,0",
            "description": "Comments posted.",
            "displayFolder": "4 Interaction",
            "lineageTag": "199e2246-493f-e913-e663-5c4431a667d2"
          },
          {
            "name": "Posts Created",
            "expression": "SUM ( fact_engagement_daily[posts_created] )",
            "formatString": "#,0",
            "description": "Original posts published.",
            "displayFolder": "4 Interaction",
            "lineageTag": "2e9d172f-7fae-c1af-d10e-f42e5fb5b7cf"
          },
          {
            "name": "Stories Viewed",
            "expression": "SUM ( fact_engagement_daily[stories_viewed] )",
            "formatString": "#,0",
            "description": "Stories viewed (zero on platforms without stories).",
            "displayFolder": "4 Interaction",
            "lineageTag": "b8900c2d-1cc3-6023-8a5e-486c1650814d"
          },
          {
            "name": "Interaction Rate %",
            "expression": "DIVIDE ( [Likes Given] + [Comments Written], [Posts Viewed] )",
            "formatString": "0.0%",
            "description": "Share of served content the student reacts to.",
            "displayFolder": "4 Interaction",
            "lineageTag": "b06cd1fe-2c06-004d-ceba-c9cbf8f3c748"
          },
          {
            "name": "Ads Seen",
            "expression": "SUM ( fact_engagement_daily[ads_seen] )",
            "formatString": "#,0",
            "description": "Ads served by all advertisers, not just CampusPulse campaigns.",
            "displayFolder": "5 Advertising",
            "lineageTag": "eb74cb5d-1708-98f9-42e7-5c072cba8434"
          },
          {
            "name": "Ads Clicked",
            "expression": "SUM ( fact_engagement_daily[ads_clicked] )",
            "formatString": "#,0",
            "description": "Ads clicked.",
            "displayFolder": "5 Advertising",
            "lineageTag": "b60793d0-0cdd-7262-e797-e38b7decb43e"
          },
          {
            "name": "Ad CTR %",
            "expression": "DIVIDE ( [Ads Clicked], [Ads Seen] )",
            "formatString": "0.00%",
            "description": "Click-through rate across all ads served.",
            "displayFolder": "5 Advertising",
            "lineageTag": "139480ff-23c0-63d9-5f32-4383d4baf4a5"
          },
          {
            "name": "Ads Seen per Day",
            "expression": "DIVIDE ( [Ads Seen], [Active Days] )",
            "formatString": "#,0.0",
            "description": "Ads served per student per active day.",
            "displayFolder": "5 Advertising",
            "lineageTag": "612b7b6f-a1ac-953a-ff3b-bf3a6076d999"
          },
          {
            "name": "Late Night Minutes",
            "expression": "SUM ( fact_engagement_daily[late_night_minutes] )",
            "formatString": "#,0",
            "description": "Minutes between 10 p.m. and 2 a.m.",
            "displayFolder": "6 Late night",
            "lineageTag": "ddb54af9-f42a-f0e1-9e7f-dbade691267d"
          },
          {
            "name": "Late-Night Share %",
            "expression": "DIVIDE ( [Late Night Minutes], [Total Minutes] )",
            "formatString": "0.0%",
            "description": "Share of all screen time that happens late at night.",
            "displayFolder": "6 Late night",
            "lineageTag": "83e648e4-eef4-31f6-052b-19d06f74038a"
          }
        ],
        "lineageTag": "007dec1b-8410-9e17-bbea-28f298a9b800"
