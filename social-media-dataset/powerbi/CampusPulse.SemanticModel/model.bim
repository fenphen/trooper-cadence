        "partitions": [
          {
            "name": "fact_connections",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(DataFile(\"fact_connections.csv\"), [Delimiter=\",\", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"user_id\", type text}, {\"connected_user_id\", type text}, {\"platform\", type text}, {\"connection_type\", type text}, {\"interaction_strength\", type number}, {\"same_university\", type logical}, {\"shared_top_interest\", type logical}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Friendships",
            "expression": "DIVIDE ( COUNTROWS ( fact_connections ), 2 )",
            "formatString": "#,0",
            "description": "Unique friendships (each edge is stored in both directions).",
            "lineageTag": "51b9253d-3cc4-bcbf-ceab-5e343eaa021c"
          },
          {
            "name": "Connections",
            "expression": "COUNTROWS ( fact_connections )",
            "formatString": "#,0",
            "description": "Directed connection rows.",
            "lineageTag": "794fe166-e7e0-e212-cc8d-9f7980447fd7"
          },
          {
            "name": "Avg Connections per Student",
            "expression": "DIVIDE ( COUNTROWS ( fact_connections ), DISTINCTCOUNT ( fact_connections[user_id] ) )",
            "formatString": "#,0.0",
            "description": "Average network size.",
            "lineageTag": "f4a8198a-1e44-573f-a7f2-e3361af36524"
          },
          {
            "name": "% Same University",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( fact_connections ), fact_connections[same_university] = TRUE ), COUNTROWS ( fact_connections ) )",
            "formatString": "0.0%",
            "description": "Share of friendships that are same-campus (homophily).",
            "lineageTag": "2c68fad1-c5e7-d672-1e18-c58b443aed34"
          },
          {
            "name": "Avg Interaction Strength",
            "expression": "AVERAGE ( fact_connections[interaction_strength] )",
            "formatString": "#,0.000",
            "description": "How often connected students actually interact.",
            "lineageTag": "14f13da6-5891-72a3-75e2-c482f0e8718c"
          }
        ],
        "lineageTag": "a7a5e8e0-7f5d-852f-a36a-adf10eba351f"
      },
