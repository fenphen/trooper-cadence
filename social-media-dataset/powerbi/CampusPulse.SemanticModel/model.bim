                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"user_id\", type text}, {\"openness\", Int64.Type}, {\"conscientiousness\", Int64.Type}, {\"extraversion\", Int64.Type}, {\"agreeableness\", Int64.Type}, {\"neuroticism\", Int64.Type}, {\"chronotype\", type text}, {\"attention_span_score\", Int64.Type}, {\"impulse_buying_score\", Int64.Type}, {\"social_influence_score\", Int64.Type}, {\"content_creator_level\", type text}, {\"values_segment\", type text}, {\"inferred_political_lean\", type text}, {\"political_lean_confidence\", type number}, {\"intent_new_phone\", type logical}, {\"intent_travel_6mo\", type logical}, {\"intent_meal_delivery\", type logical}, {\"intent_gym_membership\", type logical}, {\"intent_credit_card\", type logical}, {\"recently_moved\", type logical}}, \"en-US\")",
