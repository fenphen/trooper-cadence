    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:\\CampusPulse\\social-media-dataset\\data\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "description": "Folder holding the CampusPulse CSV files. Set this once, then refresh.",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ],
        "lineageTag": "a24d0aad-e819-5dc5-1432-ac4f61770656"
      },
      {
        "name": "DataFile",
        "kind": "m",
        "expression": [
          "let",
          "    Fn = (fileName as text) as binary =>",
          "        let",
          "            Sep = if Text.EndsWith(DataFolder, \"\\\") or Text.EndsWith(DataFolder, \"/\") then \"\" else \"\\\",",
          "            Path = DataFolder & Sep & fileName",
          "        in",
          "            File.Contents(Path)",
          "in",
          "    Fn"
        ],
        "description": "Reads one CSV from DataFolder, with or without a trailing slash.",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ],
        "lineageTag": "88b6a740-1eff-53c6-c734-2644c787de27"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DataFolder\",\"DataFile\",\"bridge_user_interests\",\"bridge_user_segments\",\"data_dictionary\",\"dim_campaigns\",\"dim_date\",\"dim_devices\",\"dim_interests\",\"dim_platform_profiles\",\"dim_platforms\",\"dim_psychographics\",\"dim_segments\",\"dim_users\",\"fact_ad_exposures\",\"fact_campaign_daily\",\"fact_connections\",\"fact_engagement_daily\",\"fact_hourly_usage\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
