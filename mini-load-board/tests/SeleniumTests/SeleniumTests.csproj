<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SeleniumTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Selenium.WebDriver 4.6+ ships "Selenium Manager", which downloads a
         matching chromedriver automatically - no manual driver install. -->
    <PackageReference Include="Selenium.WebDriver" Version="4.26.1" />
    <!-- Selenium.Support adds helpers such as SelectElement for <select> dropdowns. -->
    <PackageReference Include="Selenium.Support" Version="4.26.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
